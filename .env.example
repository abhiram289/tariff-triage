# ==============================================================================
# Tariff Triage Service Environment Configuration
# Copy this file to .env and provide your sensitive values.
# NEVER commit .env to source control! (Enforces requirement D4)
# ==============================================================================

# LLM Provider Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional alternative providers (fallback / multi-provider support)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stub Mode (For Locust load testing / requirement D6)
USE_LLM_STUB=false
LLM_STUB_DELAY_SEC=0.8

# Local Embedding & Vector Store (Requirement Section 12 & L1)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./data/index
CORPUS_DIR=./data/corpus

# Application & Worker Settings
APP_HOST=0.0.0.0
APP_PORT=8000
WORKER_CONCURRENCY=4
REDIS_URL=redis://localhost:6379/0

# Rate Limiting & Circuit Breaker (Requirements A5, D7)
RATE_LIMIT_PER_MINUTE=60
CIRCUIT_BREAKER_FAIL_MAX=3
CIRCUIT_BREAKER_RESET_TIMEOUT_SEC=30
MODEL_TIMEOUT_SEC=15
TOOL_TIMEOUT_SEC=8
MAX_AGENT_STEPS=6

# Service Level Objective (Requirement D6)
SLO_P95_SECONDS=15.0

# LLMOps & Guardrails (Requirements L2, L4, L5)
PROMPT_VERSION=v1.0.0
ENABLE_PROMPT_INJECTION_FILTER=true
ENABLE_OUTPUT_FILTER=true
ENABLE_TOXICITY_FILTER=true

# Observability & Tracing (Requirement D5)
SERVICE_NAME=tariff-triage-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
PROMETHEUS_METRICS_PATH=/metrics
